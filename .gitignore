# =========================================================
# 宠物医疗管理系统 — 全局 .gitignore
# 单仓多模块：backend(Maven) / frontend(Node) / database / docs
# =========================================================

# ---------- Java / Maven ----------
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------- Node / Vue ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 敏感信息（严禁入库） ----------
application-local.yml
application-local.properties
*.env
.env.local
.env.*.local
*.pem
*.key
*.jks

# ---------- 日志 / 临时 ----------
logs/
*.log
*.tmp
*.bak
*.orig
