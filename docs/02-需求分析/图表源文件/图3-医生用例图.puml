@startuml
' 图3 医生用例图（六模块）
left to right direction
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"

actor "医生" as Doctor

rectangle "宠物医疗管理系统" {
  usecase "登录认证" as D0

  package "预约与排班" {
    usecase "查看预约列表" as D1
    usecase "确认/驳回预约" as D2
    usecase "维护可预约时段" as D3
  }

  package "诊疗业务" {
    usecase "接诊登记" as E1
    usecase "录入电子病历" as E2
    usecase "开具处方" as E3
    usecase "处方库存校验" as E4
  }

  package "查询" {
    usecase "查看宠物历史病历" as F1
    usecase "查询宠物档案" as F2
  }
}

Doctor --> D0
Doctor --> D1
Doctor --> D2
Doctor --> D3
Doctor --> E1
Doctor --> E2
Doctor --> E3
Doctor --> E4
Doctor --> F1
Doctor --> F2

E2 ..> E1 : <<include>>
E3 ..> E4 : <<include>>
@enduml
