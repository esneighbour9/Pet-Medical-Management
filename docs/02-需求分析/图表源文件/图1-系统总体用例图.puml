@startuml
' 图1 系统总体用例图（六模块）
left to right direction
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"

actor "管理员" as Admin
actor "医生" as Doctor
actor "宠物主人" as Owner

rectangle "宠物医疗管理系统" {
  usecase "登录认证" as UC00
  usecase "用户与权限管理" as UC01
  usecase "宠物档案管理" as UC02
  usecase "预约挂号管理" as UC03
  usecase "诊疗与电子病历" as UC04
  usecase "药品与库存管理" as UC05
  usecase "收费与统计管理" as UC06
}

Admin --> UC00
Doctor --> UC00
Owner --> UC00

Admin --> UC01
Admin --> UC02
Admin --> UC05
Admin --> UC06

Doctor --> UC02
Doctor --> UC03
Doctor --> UC04

Owner --> UC02
Owner --> UC03
Owner --> UC06
@enduml
